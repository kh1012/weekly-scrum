# ====================================
# Next.js 환경변수 예시
# ====================================
# 이 파일을 복사하여 .env.local (프로덕션) 또는 .env.demo (데모)로 사용하세요.

# ====================================
# 앱 모드
# ====================================
# demo: 데모 모드 (로그인 필요, 데모 workspace 사용)
# prod: 프로덕션 모드 (로그인 필요, workspace 선택)
NEXT_PUBLIC_APP_MODE=prod

# ====================================
# Supabase 설정
# ====================================
NEXT_PUBLIC_SUPABASE_URL=your-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# ====================================
# 기본 Workspace ID
# ====================================
# 현재 모드에서 사용할 기본 workspace ID
# 프로덕션: 00000000-0000-0000-0000-000000000001
# 데모: 00000000-0000-0000-0000-000000000002
NEXT_PUBLIC_DEFAULT_WORKSPACE_ID=00000000-0000-0000-0000-000000000001
